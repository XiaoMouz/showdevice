{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostMessage",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "api": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "wire": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "type",
        "api",
        "wire",
        "capabilities"
      ]
    },
    {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/Device"
        },
        "type": {
          "type": "string",
          "const": "activate"
        }
      },
      "required": [
        "type",
        "device"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "poll"
        }
      },
      "required": [
        "type",
        "request_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "io_result"
        }
      },
      "required": [
        "type",
        "request_id",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "shutdown"
        }
      },
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "Connection": {
      "type": "string",
      "enum": [
        "usb",
        "receiver",
        "ble"
      ]
    },
    "Device": {
      "type": "object",
      "properties": {
        "connection": {
          "$ref": "#/$defs/Connection"
        },
        "feature_report_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "interface": {
          "type": "integer",
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "product_id": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "usage": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "usage_page": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "vendor_id": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "vendor_id",
        "product_id",
        "interface",
        "usage_page",
        "usage",
        "connection"
      ]
    }
  }
}