{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginMessage",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/Descriptor"
        },
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "required": [
        "type",
        "descriptor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ready"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "request_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "query"
        }
      },
      "required": [
        "type",
        "request_id",
        "name"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Reading"
          }
        },
        "type": {
          "type": "string",
          "const": "snapshot"
        }
      },
      "required": [
        "type",
        "request_id",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "request_id",
        "message"
      ]
    }
  ],
  "$defs": {
    "Availability": {
      "type": "string",
      "enum": [
        "available",
        "unknown",
        "stale",
        "unsupported",
        "offline"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "depends_on": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "effect": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "readable": {
          "type": "boolean"
        },
        "subscribable": {
          "type": "boolean"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType"
        },
        "writable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "readable",
        "writable",
        "subscribable",
        "value_type"
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "binding": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "available"
            }
          },
          "required": [
            "op",
            "binding"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "equals"
            },
            "value": true
          },
          "required": [
            "op",
            "binding",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "host_writes_enabled"
            }
          },
          "required": [
            "op"
          ]
        }
      ]
    },
    "Connection": {
      "type": "string",
      "enum": [
        "usb",
        "receiver",
        "ble"
      ]
    },
    "Descriptor": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiPage"
          }
        }
      },
      "required": [
        "manifest",
        "capabilities",
        "pages"
      ]
    },
    "DeviceMatch": {
      "type": "object",
      "properties": {
        "connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Connection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feature_report_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "interface": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "product_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "usage": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "usage_page": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "vendor_id": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "vendor_id"
      ]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "api": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "executable": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceMatch"
          }
        },
        "required": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "wire": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "version",
        "api",
        "wire",
        "executable",
        "matches"
      ]
    },
    "Reading": {
      "type": "object",
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "updated_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "value": true
      },
      "required": [
        "availability",
        "source"
      ]
    },
    "UiNode": {
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "binding": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "children": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/UiNode"
          }
        },
        "component": {
          "type": "string"
        },
        "enabled_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "visible_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "component",
        "version",
        "label"
      ]
    },
    "UiPage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiNode"
          }
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "nodes"
      ]
    },
    "ValueType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "step": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "number"
            }
          },
          "required": [
            "type",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}