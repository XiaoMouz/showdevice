<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ShowDevice</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../ui/assets/showdevice-icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" /></ItemGroup>
  <ItemGroup><Compile Include="../../ui/native/windows/PluginPage.cs" Link="PluginPage.cs" /></ItemGroup>
  <ItemGroup><Content Include="../../ui/assets/showdevice-icon.png" Link="Assets/showdevice-icon.png" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../../ui/assets/showdevice-icon.ico" Link="Assets/showdevice-icon.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- Unpackaged WinUI resources are generated after publish item discovery. -->
  <Target Name="PublishWinUIResources" AfterTargets="Publish">
    <ItemGroup>
      <WinUIResource Include="$(TargetDir)$(AssemblyName).pri" />
      <WinUIResource Include="$(TargetDir)**/*.xbf" />
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The application PRI is missing; refusing an incomplete publish." />
    <Copy SourceFiles="@(WinUIResource)" DestinationFiles="@(WinUIResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>

