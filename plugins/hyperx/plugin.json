{"product_image": "assets/product-trimmed.png",
  "manifest": {
    "id": "org.showdevice.hyperx",
    "version": "0.1.0",
    "api": ">=1.0.0, <2.0.0",
    "wire": 1,
    "executable": "sd-plugin-hyperx.exe",
    "required": [
      "state.snapshot.v1",
      "ui.declarative.v1"
    ],
    "matches": [
      {
        "vendor_id": 1008,
        "product_id": 716,
        "usage_page": 448,
        "usage": 1
      },
      {
        "vendor_id": 1008,
        "product_id": 1726,
        "usage_page": 448,
        "usage": 1
      }
    ]
  },
  "capabilities": [
    {
      "id": "battery.percent",
      "readable": true,
      "writable": false,
      "subscribable": false,
      "value_type": {
        "type": "number",
        "min": 0,
        "max": 100,
        "step": null
      }
    },
    {
      "id": "battery.charging",
      "readable": true,
      "writable": false,
      "subscribable": false,
      "value_type": {
        "type": "boolean"
      }
    }
  ],
  "pages": [
    {
      "id": "overview",
      "title": "Device status",
      "nodes": [
        {
          "id": "battery_percent",
          "component": "status",
          "version": 1,
          "label": "Battery (%)",
          "binding": "battery.percent"
        },
        {
          "id": "battery_charging",
          "component": "status",
          "version": 1,
          "label": "Charging",
          "binding": "battery.charging"
        }
      ]
    }
  ],
  "device_kind": "headset"
}
